# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=amcds
POSTGRES_PASSWORD=amcds_password
POSTGRES_DB=amcds_db

REDIS_HOST=localhost
REDIS_PORT=6379

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=amcds_password

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=amcds-telemetry

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# LLM (optional — demos run offline without keys)
MODEL_PROVIDER=local
MODEL_NAME=llama3
LOCAL_MODEL_URL=http://localhost:8000/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Simulation
SIM_MAX_TICKS=1000
SIM_TICK_RATE=1.0
SIM_TELEMETRY_ENABLED=true
